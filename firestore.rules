rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Money, PINs and child sessions only change through Cloud Functions (functions/src),
    // so the browser can never edit a balance or skip the PIN check.

    match /families/{familyId} {
      allow get: if isFamilyMember(familyId);
      // Registration: each parent account creates exactly one family, keyed by its uid
      allow create: if isParentAccount()
        && familyId == request.auth.uid + '_family'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isParentOf(familyId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy']);

      // Names and avatars shown on the sibling list. PIN hashes live in /pins instead.
      match /loginProfiles/{profileId} {
        allow read: if isFamilyMember(familyId);
        allow update: if isParentOf(familyId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'avatarEmoji']);
        allow delete: if isParentOf(familyId);
      }

      match /pins/{childId} {
        allow read, write: if false;
      }
    }

    match /users/{userId} {
      allow get: if canAccessUser(userId);
      allow list: if isParentOf(resource.data.familyId);

      // Registration: a parent creates their own profile, with an empty wallet, in their own family
      allow create: if isParentAccount()
        && request.auth.uid == userId
        && request.resource.data.role == 'parent'
        && request.resource.data.familyId == userId + '_family'
        && request.resource.data.balance == 0
        && request.resource.data.totalSavings == 0;

      // Parents edit their own profile and their children's (including setting a balance),
      // but nobody can change roles or move between families
      allow update: if isParentAccount()
        && (request.auth.uid == userId || isParentInSameFamily(userId))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'role', 'familyId', 'createdAt', 'lastAuthUid']);

      // A logged-in child can only register their device for notifications
      allow update: if isChildSessionFor(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']);

      match /transactions/{txId} {
        allow read: if canAccessUser(userId);
        // Parents can fix the wording, never the money
        allow update: if isParentInSameFamily(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'amount', 'balanceAfter', 'type', 'createdAt', 'createdBy', 'savingsId']);
        allow delete: if isParentInSameFamily(userId);
      }

      match /allowances/{allowanceId} {
        allow read: if canAccessUser(userId);
        allow create, update, delete: if isParentInSameFamily(userId);
      }

      match /savings/{savingsId} {
        allow read: if canAccessUser(userId);
        // Deleting a transaction from a goal reverses it on the goal
        allow update: if isParentInSameFamily(userId);
      }
    }

    // Links a child's anonymous sign-in to their profile; written only by childLogin
    match /childSessions/{sessionUid} {
      allow get, delete: if request.auth != null && request.auth.uid == sessionUid;
    }

    function isParentAccount() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function requesterPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function sessionPath() {
      return /databases/$(database)/documents/childSessions/$(request.auth.uid);
    }

    function isParentOf(familyId) {
      return isParentAccount()
        && exists(requesterPath())
        && get(requesterPath()).data.role == 'parent'
        && get(requesterPath()).data.familyId == familyId;
    }

    function isParentInSameFamily(targetUserId) {
      let target = get(/databases/$(database)/documents/users/$(targetUserId));
      return isParentOf(target.data.familyId);
    }

    function hasChildSession() {
      return request.auth != null
        && exists(sessionPath())
        && get(sessionPath()).data.expiresAt > request.time;
    }

    function isChildSessionFor(targetUserId) {
      let target = get(/databases/$(database)/documents/users/$(targetUserId));
      return hasChildSession()
        && get(sessionPath()).data.userId == targetUserId
        && target.data.get('isActive', true) != false;
    }

    function isFamilyMember(familyId) {
      return isParentOf(familyId)
        || (hasChildSession() && get(sessionPath()).data.familyId == familyId);
    }

    function canAccessUser(targetUserId) {
      return (isParentAccount() && request.auth.uid == targetUserId)
        || isParentInSameFamily(targetUserId)
        || isChildSessionFor(targetUserId);
    }
  }
}
